---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Button from "@/components/ui/Button.astro";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
const now = new Date();

const upcoming = allEvents
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const past = allEvents
  .filter((e) => e.data.date < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const title = "Events — Mad Robin Ceilidh Band";
const description =
  "Find upcoming public ceilidhs by Mad Robin in Exeter and Devon. Come along, no experience or partner needed!";
---

<PageLayout title={title} description={description}>
  <!-- Upcoming events -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHeading
        tag="h1"
        title="Upcoming Events"
        subtitle="Come see us live at a public ceilidh"
      />

      {
        upcoming.length > 0 ? (
          <div class="events-list">
            {upcoming.map((e) => (
              <div class="event-card">
                <div class="event-date-badge">
                  <span class="event-day">{e.data.date.getDate()}</span>
                  <span class="event-month">
                    {e.data.date.toLocaleDateString("en-GB", {
                      month: "short",
                    })}
                  </span>
                  <span class="event-year">
                    {e.data.date.getFullYear()}
                  </span>
                </div>
                <div class="event-info">
                  <h2>{e.data.title}</h2>
                  <p class="event-venue">{e.data.venue}</p>
                  {e.data.address && (
                    <p class="event-address">{e.data.address}</p>
                  )}
                  <p class="event-desc">{e.data.description}</p>
                  <div class="event-footer">
                    {e.data.ticketPrice && (
                      <span class="event-price">{e.data.ticketPrice}</span>
                    )}
                    {e.data.ticketLink && (
                      <a
                        href={e.data.ticketLink}
                        class="event-ticket-link"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Get Tickets →
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="no-events">
            <p>
              No public ceilidhs currently scheduled. Follow us on social media
              for announcements!
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- Past events -->
  {
    past.length > 0 && (
      <section class="section section--alt">
        <div class="container container--narrow">
          <SectionHeading title="Past Events" />
          <details class="past-events-toggle">
            <summary>
              View {past.length} past event{past.length !== 1 ? "s" : ""}
            </summary>
            <div class="events-list past-list">
              {past.map((e) => (
                <div class="event-card event-card--past">
                  <div class="event-date-badge event-date-badge--past">
                    <span class="event-day">{e.data.date.getDate()}</span>
                    <span class="event-month">
                      {e.data.date.toLocaleDateString("en-GB", {
                        month: "short",
                      })}
                    </span>
                    <span class="event-year">{e.data.date.getFullYear()}</span>
                  </div>
                  <div class="event-info">
                    <h3>{e.data.title}</h3>
                    <p class="event-venue">{e.data.venue}</p>
                  </div>
                </div>
              ))}
            </div>
          </details>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="cta-banner">
    <div class="container cta-banner-inner">
      <h2>Want Mad Robin at your event?</h2>
      <p>We play weddings, corporate events, and private parties across Devon and the Southwest.</p>
      <Button href="/book-us/" size="lg" variant="outline">Book Us</Button>
    </div>
  </section>
</PageLayout>

<style>
  .events-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .event-card {
    display: flex;
    gap: var(--space-lg);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .event-date-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 70px;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-accent-gold);
    border-radius: var(--radius-md);
    color: var(--color-text-on-accent);
    text-align: center;
    flex-shrink: 0;
  }

  .event-date-badge--past {
    background-color: var(--color-bg-card-hover);
    color: var(--color-text-muted);
  }

  .event-day {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1;
  }

  .event-month {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .event-year {
    font-size: var(--text-xs);
    opacity: 0.8;
  }

  .event-info h2,
  .event-info h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .event-venue {
    color: var(--color-accent-copper);
    font-weight: 600;
    font-size: var(--text-sm);
    margin-bottom: var(--space-xs);
  }

  .event-address {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-sm);
  }

  .event-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .event-footer {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .event-price {
    font-weight: 700;
    color: var(--color-accent-gold);
    font-size: var(--text-sm);
  }

  .event-ticket-link {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .no-events {
    text-align: center;
    padding: var(--space-3xl);
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border);
  }

  .no-events p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .event-card--past {
    opacity: 0.7;
  }

  /* Past events toggle */
  .past-events-toggle {
    cursor: pointer;
  }

  .past-events-toggle summary {
    font-weight: 700;
    color: var(--color-accent-gold);
    padding: var(--space-md) 0;
    font-size: var(--text-lg);
    list-style: none;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .past-events-toggle summary::before {
    content: "▸";
    margin-right: var(--space-sm);
    transition: transform var(--transition-fast);
  }

  .past-events-toggle[open] summary::before {
    transform: rotate(90deg);
  }

  .past-list {
    margin-top: var(--space-lg);
  }

  /* CTA Banner */
  .cta-banner {
    background: linear-gradient(
      135deg,
      var(--color-accent-gold),
      var(--color-accent-terracotta)
    );
    padding: var(--space-4xl) 0;
  }

  .cta-banner-inner {
    text-align: center;
  }

  .cta-banner h2 {
    color: var(--color-text-on-accent);
    margin-bottom: var(--space-md);
  }

  .cta-banner p {
    color: var(--color-text-on-accent-muted);
    font-size: var(--text-lg);
    margin-bottom: var(--space-xl);
  }

  .cta-banner :global(.btn--outline) {
    border-color: var(--color-text-on-accent);
    color: var(--color-text-on-accent);
  }

  .cta-banner :global(.btn--outline:hover) {
    background-color: var(--color-text-on-accent);
    color: var(--color-accent-gold);
  }
</style>
