---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Button from "@/components/ui/Button.astro";
import PlaceholderImage from "@/components/ui/PlaceholderImage.astro";
import SwipeCarousel from "@/components/ui/SwipeCarousel.astro";
import CalendarButtons from "@/components/ui/CalendarButtons.astro";
import { Image } from "astro:assets";
import heroLogo from "@/assets/images/logo.png";
import heroBand from "@/assets/images/hero-band.jpg";
import { getCollection, render } from "astro:content";
import siteSettings from "@/data/settings/site.yml";

// Fetch content
const allTestimonials = await getCollection("testimonials");
const featuredTestimonials = allTestimonials
  .filter((t) => t.data.featured)
  .slice(0, 3);

const allEvents = await getCollection("events");
const upcomingEvents = allEvents
  .filter((e) => e.data.date >= new Date())
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);

const allMembers = await getCollection("members");
const members = allMembers.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const allGallery = await getCollection("gallery");
const galleryItems = allGallery
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 6);

const allFaq = await getCollection("faq");
const faqItems = allFaq.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const allExpect = await getCollection("whatToExpect");
const expectItems = allExpect.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

function formatTime12h(time: string): string {
  const [h, m] = time.split(":").map(Number);
  const period = h >= 12 ? "pm" : "am";
  const hour = h % 12 || 12;
  return m === 0 ? `${hour}${period}` : `${hour}:${String(m).padStart(2, "0")}${period}`;
}

// Extract YouTube video ID from various URL formats
function getYouTubeId(url: string): string | null {
  if (!url) return null;
  const match = url.match(
    /(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|shorts\/))([a-zA-Z0-9_-]{11})/
  );
  return match ? match[1] : null;
}
const showreelVideoId = getYouTubeId(siteSettings.showreelUrl || "");


const title =
  "Mad Robin — Live Ceilidh & Early English Music in Devon & the Southwest";
const description =
  "Mad Robin are a live English ceilidh band and early music ensemble based in Exeter, Devon. Book us for weddings, private parties & public ceilidhs.";

const eventsJsonLd = upcomingEvents.map((e) => ({
  "@context": "https://schema.org",
  "@type": "Event",
  name: e.data.title,
  startDate: e.data.startTime
    ? `${e.data.date.toISOString().split("T")[0]}T${e.data.startTime}:00`
    : e.data.date.toISOString().split("T")[0],
  location: {
    "@type": "Place",
    name: e.data.venue,
    ...(e.data.address ? { address: e.data.address } : {}),
  },
  description: e.data.description,
  organizer: {
    "@type": "MusicGroup",
    name: "Mad Robin Ceilidh Band",
    url: "https://madrobinceilidh.co.uk",
  },
  url: "https://madrobinceilidh.co.uk/#events",
}));

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "MusicGroup",
    name: "Mad Robin Ceilidh Band",
    url: "https://madrobinceilidh.co.uk",
    description,
    genre: ["Ceilidh", "Folk", "English Country Dance", "Early English Music", "Playford"],
    areaServed: {
      "@type": "GeoCircle",
      geoMidpoint: {
        "@type": "GeoCoordinates",
        latitude: 50.7184,
        longitude: -3.5339,
      },
      geoRadius: "100 mi",
    },
    location: {
      "@type": "City",
      name: "Exeter",
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: "Devon",
      },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://madrobinceilidh.co.uk/#business",
    name: "Mad Robin Ceilidh Band",
    url: "https://madrobinceilidh.co.uk",
    description,
    email: "madrobinband@gmail.com",
    telephone: "+44 7849 035551",
    areaServed: ["Devon", "Southwest England", "Exeter"],
    priceRange: "$$",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Exeter",
      addressRegion: "Devon",
      addressCountry: "GB",
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: 50.7184,
      longitude: -3.5339,
    },
  },
  ...eventsJsonLd,
]);
---

<PageLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />

  <!-- ======== HERO ======== -->
  <section class="hero">
    <Image
      src={heroBand}
      alt=""
      class="hero-bg"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
    <div class="hero-logo-wrap">
      <Image
        src={heroLogo}
        alt="Mad Robin"
        class="hero-logo"
        widths={[360, 460, 720]}
        sizes="(min-width: 768px) 460px, 360px"
        format="webp"
        quality={80}
        fetchpriority="high"
      />
    </div>
    <h1 class="sr-only">Mad Robin</h1>
    <div class="hero-bottom">
      <div class="container hero-bottom-inner">
        <p class="hero-tagline">
          Live ceilidh & early English music for weddings, parties & events in Devon and
          the Southwest
        </p>
        <Button href="/book-us/" size="lg">Book Us</Button>
      </div>
    </div>
  </section>

  <!-- ======== TRUST BAR ======== -->
  <section class="trust-bar">
    <div class="container trust-bar-inner">
      <span>Serving Devon & the Southwest</span>
      <span class="trust-divider" aria-hidden="true">&middot;</span>
      <span>Live caller included</span>
      <span class="trust-divider" aria-hidden="true">&middot;</span>
      <span>No experience needed</span>
    </div>
  </section>

  <!-- ======== WHAT WE DO ======== -->
  <section class="section" id="what-we-do">
    <div class="container">
      <SectionHeading
        title="What We Do"
        subtitle="Live ceilidh and early music entertainment for every occasion"
      />
      <p class="ceilidh-info-link">
        New to ceilidh? <a href="#what-is-a-ceilidh">Find out what it's all about &rarr;</a>
      </p>

      <h3 class="services-subheading">Ceilidhs</h3>
      <SwipeCarousel id="carousel-ceilidhs" label="Ceilidh services" class="services-grid">
        <div class="service-card">
          <div class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
          </div>
          <h4>Weddings</h4>
          <p>
            Get every guest on the dance floor with an unforgettable ceilidh.
            All dances called — no experience needed, just enthusiasm.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h4>Private Parties</h4>
          <p>
            Birthdays, anniversaries, or just a great excuse to celebrate. A
            ceilidh is the ultimate party — energetic, inclusive, and guaranteed
            to get everyone dancing.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18V5l12-2v13"/>
              <circle cx="6" cy="18" r="3"/>
              <circle cx="18" cy="16" r="3"/>
            </svg>
          </div>
          <h4>Public Ceilidhs</h4>
          <p>
            We host seasonal public ceilidhs in Exeter. Come along, meet new
            people, and dance the night away. All welcome!
          </p>
        </div>
      </SwipeCarousel>

      <h3 class="services-subheading">Performance</h3>
      <SwipeCarousel id="carousel-performance" label="Performance services" class="services-grid">
        <div class="service-card">
          <div class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h4>Concerts & Festivals</h4>
          <p>
            Performances at folk festivals, early music festivals, concert
            halls, and folk clubs. Repertoire from Playford, English folk,
            and country dance traditions.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 2h8l-2 10h-4L8 2z"/>
              <line x1="12" y1="12" x2="12" y2="20"/>
              <line x1="8" y1="20" x2="16" y2="20"/>
            </svg>
          </div>
          <h4>Events & Functions</h4>
          <p>
            Atmospheric live music for dinners, receptions, and garden
            parties. Background or feature music tailored to the occasion.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="2" width="6" height="11" rx="3"/>
              <path d="M19 10v1a7 7 0 0 1-14 0v-1"/>
              <line x1="12" y1="18" x2="12" y2="22"/>
              <line x1="8" y1="22" x2="16" y2="22"/>
            </svg>
          </div>
          <h4>Receptions</h4>
          <p>
            Elegant live background music for wedding receptions, drinks
            receptions, and formal dinners. Early English and folk
            repertoire to set the perfect atmosphere.
          </p>
        </div>
      </SwipeCarousel>
    </div>
  </section>

  <!-- ======== SEE US IN ACTION ======== -->
  <section class="section section--alt" id="see-us">
    <div class="container">
      <SectionHeading
        title="See Us in Action"
        subtitle="Watch and listen to get a taste of what we do"
      />
      <div class="video-container">
        {showreelVideoId ? (
          <div class="video-embed">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${showreelVideoId}`}
              title="Mad Robin showreel"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        ) : (
          <div class="video-placeholder">
            <div class="video-placeholder-inner">
              <span class="video-play-icon" aria-hidden="true">&#9654;</span>
              <p>Showreel coming soon</p>
              <p class="video-sub">
                Check back soon for a taste of Mad Robin live
              </p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ======== GALLERY ======== -->
  <section class="section" id="gallery">
    <div class="container">
      <SectionHeading
        title="Gallery"
        subtitle="Photos and videos from our events"
      />

      <!-- Gallery grid -->
      <SwipeCarousel
        id="gallery-grid"
        label="Gallery photos and videos"
        class="gallery-grid"
        desktopGrid="repeat(auto-fill, minmax(250px, 1fr))"
        cardMinWidth="85%"
      >
        {
          galleryItems.length > 0
            ? galleryItems.map((item) => (
                <a
                  href={item.data.image || "#"}
                  class:list={[
                    "gallery-item",
                    { "gallery-item--video": !!item.data.video },
                    { "gallery-item--video-only": !!item.data.video && !item.data.image },
                  ]}
                  data-category={item.data.category}
                  data-pswp-width={item.data.video && !item.data.image ? "1280" : ""}
                  data-pswp-height={item.data.video && !item.data.image ? "720" : ""}
                  {...(item.data.video ? { "data-video-src": item.data.video } : {})}
                >
                  {item.data.image ? (
                    <img
                      src={item.data.image}
                      alt="Gallery photo"
                      loading="lazy"
                      width="400"
                      height="300"
                    />
                  ) : (
                    <div class="gallery-video-placeholder">
                      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                        <line x1="7" y1="2" x2="7" y2="22"/>
                        <line x1="17" y1="2" x2="17" y2="22"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <line x1="2" y1="7" x2="7" y2="7"/>
                        <line x1="2" y1="17" x2="7" y2="17"/>
                        <line x1="17" y1="7" x2="22" y2="7"/>
                        <line x1="17" y1="17" x2="22" y2="17"/>
                      </svg>
                    </div>
                  )}
                  {item.data.video && (
                    <span class="gallery-play-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </span>
                  )}
                </a>
              ))
            : Array.from({ length: 6 }).map((_, i) => (
                <div class="gallery-placeholder-card" data-category="All">
                  <PlaceholderImage
                    alt={`Gallery photo coming soon ${i + 1}`}
                    aspectRatio="4 / 3"
                    icon="📷"
                  />
                </div>
              ))
        }
      </SwipeCarousel>
      <p class="gallery-see-all">
        <a href="/gallery" class="gallery-see-all-link">See all photos &amp; videos &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ======== ABOUT THE BAND ======== -->
  <section class="section section--alt" id="about">
    <div class="container">
      <SectionHeading title="About the Band" />

      <div class="story-text">
        <p>
          Mad Robin are a lively 5-piece English ceilidh band with a caller,
          based in Exeter, Devon. We play weddings, private parties, and host
          seasonal public ceilidhs across Devon and the Southwest.
        </p>
        <p>
          Alongside our ceilidhs, we also perform traditional folk music at concerts, festivals, and events.
        </p>
        <p>
          Every dance is walked through by our caller before the music starts. No experience or partner required.
        </p>
      </div>

      <SwipeCarousel id="carousel-members" label="Band members" desktopGrid="repeat(2, 1fr)" desktopGridLg="repeat(3, 1fr)" class="members-grid">
        {
          members.map(async (member) => {
            const { Content } = await render(member);
            return (
              <div class="member-card">
                <div class="member-photo">
                  {member.data.photo ? (
                    <img
                      src={member.data.photo}
                      alt={`${member.data.name} — ${member.data.instrument}`}
                      loading="lazy"
                    />
                  ) : (
                    <PlaceholderImage
                      alt={`${member.data.name} — ${member.data.instrument}`}
                      aspectRatio="1 / 1"
                      icon="🎵"
                    />
                  )}
                </div>
                <div class="member-info">
                  <h3>{member.data.name}</h3>
                  <p class="member-instrument">{member.data.instrument}</p>
                  <div class="member-bio">
                    <Content />
                  </div>
                </div>
              </div>
            );
          })
        }
      </SwipeCarousel>
    </div>
  </section>

  <!-- ======== TESTIMONIALS ======== -->
  {
    featuredTestimonials.length > 0 && (
      <section class="section section--warm" id="testimonials">
        <div class="container">
          <SectionHeading title="What People Say" />
          <div class="testimonials-grid">
            {featuredTestimonials.map(async (t) => {
              const { Content } = await render(t);
              return (
                <blockquote class="testimonial-card">
                  <div class="testimonial-quote">
                    <Content />
                  </div>
                  <footer class="testimonial-footer">
                    <cite class="testimonial-name">{t.data.clientName}</cite>
                    {t.data.venue && (
                      <span class="testimonial-venue">{t.data.venue}</span>
                    )}
                    <span class="testimonial-type">{t.data.eventType}</span>
                  </footer>
                </blockquote>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- ======== WHAT IS A CEILIDH? ======== -->
  <section class="section" id="what-is-a-ceilidh">
    <div class="container container--narrow">
      <SectionHeading
        title="What is a Ceilidh?"
        subtitle="Everything you need to know about ceilidh dancing"
      />

      <div class="intro-text">
        <p class="pronunciation">
          <strong>Ceilidh</strong> — pronounced <em>"KAY-lee"</em>
        </p>
        <p>
          A ceilidh is a social gathering with live folk music and group
          dancing. It's one of the most inclusive and joyful forms of
          entertainment you can have at an event — everyone dances, from
          children to grandparents, and no experience is needed whatsoever.
        </p>
        <p>
          The word "ceilidh" comes from the Gaelic for "a visit" or "social
          gathering." While the tradition has its roots in Scotland and Ireland,
          English ceilidh (sometimes called "barn dances") draws on a rich
          tradition of English country dance that goes back centuries.
        </p>
      </div>
    </div>

    <div class="container">
      <h3 class="expect-heading">What to Expect</h3>
      <SwipeCarousel id="carousel-expect" label="What to expect at a ceilidh" class="expect-grid">
        {expectItems.map(async (item) => {
          const { Content } = await render(item);
          return (
            <div class="expect-item">
              <h4>{item.data.title}</h4>
              <Content />
            </div>
          );
        })}
      </SwipeCarousel>
    </div>

    <!-- FAQ -->
    {
      faqItems.length > 0 && (
        <div class="container container--narrow faq-section">
          <h3 class="expect-heading">Frequently Asked Questions</h3>
          <div class="faq-list">
            {faqItems.map(async (item) => {
              const { Content } = await render(item);
              return (
                <details class="faq-item">
                  <summary class="faq-question">{item.data.question}</summary>
                  <div class="faq-answer">
                    <Content />
                  </div>
                </details>
              );
            })}
          </div>
        </div>
      )
    }
  </section>

  <!-- ======== UPCOMING EVENTS ======== -->
  {
    upcomingEvents.length > 0 && (
      <section class="section section--alt" id="events">
        <div class="container">
          <SectionHeading
            title="Upcoming Events"
            subtitle="Come see us live"
          />
          <SwipeCarousel id="carousel-events" label="Upcoming events" desktopGrid="1fr" cardMinWidth="92%" class="events-grid">
            {upcomingEvents.map((e) => (
              <div class="event-card">
                <div class="event-date-badge">
                  <span class="event-day">
                    {e.data.date.getDate()}
                  </span>
                  <span class="event-month">
                    {e.data.date.toLocaleDateString("en-GB", {
                      month: "short",
                    })}
                  </span>
                  {e.data.startTime && (
                    <span class="event-time">
                      {formatTime12h(e.data.startTime)}
                    </span>
                  )}
                </div>
                <div class="event-info">
                  <h3>{e.data.title}</h3>
                  {e.data.mapLink ? (
                    <a
                      class="event-venue event-venue-link"
                      href={e.data.mapLink}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {e.data.venue}
                    </a>
                  ) : (
                    <p class="event-venue">{e.data.venue}</p>
                  )}
                  <p class="event-desc">{e.data.description}</p>
                  {e.data.ticketingEnabled && e.data.tiers && e.data.tiers.length > 0 ? (
                    <div class="event-ticket-row">
                      <span class="event-price">
                        {e.data.tiers.map((t: {name: string, price: number}, i: number) => (
                          <span class="tier-pair">{t.name}: £{t.price.toFixed(2)}{i < (e.data.tiers?.length ?? 0) - 1 ? " · " : ""}</span>
                        ))}
                      </span>
                      <span class="event-availability" data-slug={e.id} aria-live="polite"></span>
                      <a href={`/events/${e.id}`} class="event-ticket-link">
                        Get Tickets &rarr;
                      </a>
                    </div>
                  ) : null}
                  <CalendarButtons
                    id={e.id}
                    title={e.data.title}
                    date={e.data.date}
                    startTime={e.data.startTime}
                    venue={e.data.venue}
                    description={e.data.description}
                    ticketPrice={e.data.tiers ? e.data.tiers.map((t: {name: string, price: number}) => `${t.name}: £${t.price.toFixed(2)}`).join(", ") : undefined}
                    ticketLink={e.data.ticketingEnabled && e.data.capacity ? `https://madrobinband.co.uk/events/${e.id}` : undefined}
                  />
                </div>
              </div>
            ))}
          </SwipeCarousel>
          <div class="events-subscribe">
            <p class="events-subscribe-label">Subscribe to all events</p>
            <div class="events-subscribe-links">
              <a
                href={`https://calendar.google.com/calendar/r?cid=${encodeURIComponent("https://madrobinceilidh.co.uk/events/feed.ics")}`}
                target="_blank"
                rel="noopener noreferrer"
                class="cal-btn"
              >
                + Google Calendar
              </a>
              <a href="webcal://madrobinceilidh.co.uk/events/feed.ics" class="cal-btn">
                + iCal / Outlook
              </a>
            </div>
            <span class="events-subscribe-hint">stay up to date as new gigs are added</span>
          </div>
        </div>
      </section>
    )
  }

</PageLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
  }

  .hero-bg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 1023px) {
    .hero-bg {
      height: 85vh;
      object-fit: cover;
      object-position: center 30%;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(45, 58, 45, 0.05) 0%,
      rgba(45, 58, 45, 0.35) 50%,
      rgba(45, 58, 45, 0.65) 100%
    );
    pointer-events: none;
  }

  .hero-logo-wrap {
    position: absolute;
    top: var(--space-sm);
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 2;
  }

  .hero-logo {
