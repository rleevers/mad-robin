---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Button from "@/components/ui/Button.astro";
import SwipeCarousel from "@/components/ui/SwipeCarousel.astro";
import CalendarButtons from "@/components/ui/CalendarButtons.astro";
import { Image } from "astro:assets";
import heroLogo from "@/assets/images/logo.png";
import heroBand from "@/assets/images/hero-band.jpg";
import { getCollection, render } from "astro:content";
import siteSettings from "@/data/settings/site.yml";
import { isEventPast, eventJsonLd } from "@/lib/events";

// Fetch content
const allTestimonials = await getCollection("testimonials");
const featuredTestimonials = allTestimonials
  .filter((t) => t.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const allEvents = await getCollection("events");
const upcomingEvents = allEvents
  .filter((e) => !isEventPast(e.data.date))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);

const allMembers = await getCollection("members");
const members = allMembers.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const allGallery = await getCollection("gallery");
const galleryItems = allGallery.sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const galleryCategories = ["All", "Weddings", "Barn Dances", "Private", "Public"];
// Filter tabs only appear once the gallery has more than one type of item.
const showGalleryFilters = new Set(galleryItems.map((item) => item.data.category)).size > 1;

const allFaq = await getCollection("faq");
const faqItems = allFaq.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

// "6:30pm–9pm", or "11am–1pm"; the first am/pm is dropped when both match ("6:30–9pm").
function formatTimeRange(start: string, end?: string): string {
  const from = formatTime12h(start);
  if (!end) return from;
  const to = formatTime12h(end);
  const samePeriod = from.slice(-2) === to.slice(-2);
  return `${samePeriod ? from.slice(0, -2) : from}–${to}`;
}

function formatTime12h(time: string): string {
  const [h, m] = time.split(":").map(Number);
  const period = h >= 12 ? "pm" : "am";
  const hour = h % 12 || 12;
  return m === 0 ? `${hour}${period}` : `${hour}:${String(m).padStart(2, "0")}${period}`;
}

// Extract YouTube video ID from various URL formats
function getYouTubeId(url: string): string | null {
  if (!url) return null;
  const match = url.match(
    /(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|shorts\/))([a-zA-Z0-9_-]{11})/
  );
  return match ? match[1] : null;
}
const showreelVideoId = getYouTubeId(siteSettings.showreelUrl || "");


const title = "Mad Robin | Ceilidh Band & Public Ceilidhs in Exeter, Devon";
const description =
  "Exeter ceilidh band with caller for weddings, parties & barn dances across Devon. Come and dance at our public ceilidhs in Exeter: no experience or partner needed.";

// Social profiles, so Google ties the site to the band's other pages.
const sameAs = [
  siteSettings.socialLinks?.facebook,
  siteSettings.socialLinks?.instagram,
  siteSettings.socialLinks?.youtube,
].filter(Boolean);

const eventsJsonLd = upcomingEvents.map((e) => eventJsonLd(e.id, e.data, Astro.site!));

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "MusicGroup",
    name: "Mad Robin Band",
    alternateName: ["Mad Robin", "Mad Robin Ceilidh Band"],
    url: Astro.site!.href,
    description,
    sameAs,
    genre: ["Ceilidh", "Folk", "English Country Dance", "Early English Music", "Playford"],
    areaServed: {
      "@type": "GeoCircle",
      geoMidpoint: {
        "@type": "GeoCoordinates",
        latitude: 50.7184,
        longitude: -3.5339,
      },
      geoRadius: "100 mi",
    },
    location: {
      "@type": "City",
      name: "Exeter",
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: "Devon",
      },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": new URL("/#business", Astro.site).href,
    name: "Mad Robin Band",
    alternateName: ["Mad Robin", "Mad Robin Ceilidh Band"],
    url: Astro.site!.href,
    description,
    sameAs,
    email: "madrobinband@gmail.com",
    areaServed: ["Devon", "Southwest England", "Exeter"],
    priceRange: "$$",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Exeter",
      addressRegion: "Devon",
      addressCountry: "GB",
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: 50.7184,
      longitude: -3.5339,
    },
  },
  ...eventsJsonLd,
]);
---

<PageLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />

  <!-- ======== HERO ======== -->
  <section class="hero">
    <Image
      src={heroBand}
      alt=""
      id="hero-bg"
      class="hero-bg"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
    <div class="hero-logo-wrap">
      <Image
        src={heroLogo}
        alt="Mad Robin"
        class="hero-logo"
        widths={[360, 460, 720]}
        sizes="(min-width: 768px) 460px, 360px"
        format="webp"
        quality={80}
        fetchpriority="high"
      />
    </div>
    <h1 class="sr-only">Mad Robin — Ceilidh Band &amp; Public Ceilidhs in Exeter, Devon</h1>
    <div class="hero-bottom">
      <div class="container hero-bottom-inner">
        <p class="hero-tagline">
          Live ceilidh & folk music for weddings, parties & events in Devon and
          the Southwest
        </p>
        <Button href="/book-us/" size="lg">Enquire</Button>
      </div>
    </div>
  </section>

  <!-- ======== WELCOME ======== -->
  <section class="section" id="welcome">
    <div class="container">
      <SectionHeading title="Welcome!" />
      <div class="welcome-text">
        <p>
          If you are looking for a chirpy ceilidh band, you&rsquo;ve come to the right
          place. We are Mad Robin, a five-piece band from <strong>Exeter</strong>.
        </p>
        <p>
          Our caller, Felix, has been calling ceilidhs since 2018. Our band consists of
          <strong>fiddle</strong> (Richard Leevers), <strong>woodwind</strong> (Serena Rosewood),
          <strong>guitar</strong> (Matthew Aaronson), <strong>cello</strong> (Faye Rosewood), and
          <strong>bodhrán/concertina</strong> (Felix Weedon).
        </p>
        <p>
          We play events across Devon, and run our own public ceilidhs in Exeter, which
          are the best way to check us out. Or, take a look at our showreel below!
        </p>
      </div>
    </div>
  </section>

  <!-- ======== UPCOMING EVENTS ======== -->
  {
    upcomingEvents.length > 0 && (
      <section class="section" id="events">
        <div class="container">
          <SectionHeading title="Public Events" />
          <div class="events-grid">
          <SwipeCarousel id="carousel-events" label="Upcoming events" desktopGrid="1fr" cardMinWidth="100%">
            {upcomingEvents.map((e) => (
              <div class="event-card">
                <div class="event-date-badge">
                  <span class="event-day">
                    {e.data.date.getDate()}
                  </span>
                  <span class="event-month">
                    {e.data.date.toLocaleDateString("en-GB", {
                      month: "short",
                    })}
                  </span>
                  {e.data.startTime && (
                    <span class="event-time">
                      {formatTimeRange(e.data.startTime, e.data.endTime)}
                    </span>
                  )}
                </div>
                <div class="event-info">
                  <h3>{e.data.title}</h3>
                  {e.data.mapLink ? (
                    <a
                      class="event-venue event-venue-link"
                      href={e.data.mapLink}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {e.data.venue}
                    </a>
                  ) : (
                    <p class="event-venue">{e.data.venue}</p>
                  )}
                  <p class="event-desc">{e.data.description}</p>
                  {e.data.tiers && e.data.tiers.length > 0 && (e.data.ticketingEnabled || e.data.ticketUrl) ? (
                    <div class="event-ticket-row">
                      <span class="event-price">
                        {e.data.tiers.map((t: {name: string, price: number}, i: number) => (
                          <span class="tier-pair">{t.name}: £{t.price.toFixed(2)}{i < (e.data.tiers?.length ?? 0) - 1 ? " · " : ""}</span>
                        ))}
                      </span>
                      {e.data.ticketUrl ? (
                        <a href={e.data.ticketUrl} class="event-ticket-link" target="_blank" rel="noopener noreferrer">
                          Get Tickets &rarr;
                        </a>
                      ) : (
                        <>
                          <span class="event-availability" data-slug={e.id} aria-live="polite"></span>
                          <a href={`/events/${e.id}`} class="event-ticket-link">
                            Get Tickets &rarr;
                          </a>
                        </>
                      )}
                    </div>
                  ) : null}
                  <CalendarButtons
                    id={e.id}
                    title={e.data.title}
                    date={e.data.date}
                    startTime={e.data.startTime}
                    venue={e.data.venue}
                    description={e.data.description}
                    ticketPrice={e.data.tiers ? e.data.tiers.map((t: {name: string, price: number}) => `${t.name}: £${t.price.toFixed(2)}`).join(", ") : undefined}
                    ticketLink={e.data.ticketUrl ?? (e.data.ticketingEnabled && e.data.capacity ? `https://madrobinband.co.uk/events/${e.id}` : undefined)}
                    sheetMusicPdf={e.data.sheetMusicPdf}
                  />
                </div>
              </div>
            ))}
          </SwipeCarousel>
          </div>
        </div>
      </section>
    )
  }

  <!-- ======== TESTIMONIALS ======== -->
  {
    featuredTestimonials.length > 0 && (
      <section class="section" id="testimonials">
        <div class="container">
          <SectionHeading title="What People Say" />
          <SwipeCarousel id="carousel-testimonials" label="Reviews" cardMinWidth="85%">
            {featuredTestimonials.map(async (t) => {
              const { Content } = await render(t);
              return (
                <blockquote class="testimonial-card">
                  <div class="testimonial-quote">
                    <Content />
                  </div>
                  <footer class="testimonial-footer">
                    {t.data.rating && (
                      <span class="testimonial-stars" role="img" aria-label={`${t.data.rating} out of 5 stars`}>
                        {"★".repeat(t.data.rating)}
                      </span>
                    )}
                    <cite class="testimonial-name">{t.data.clientName}</cite>
                    {t.data.venue && (
                      <span class="testimonial-venue">{t.data.venue}</span>
                    )}
                    {t.data.source && <span class="testimonial-type">{t.data.source} review</span>}
                    {t.data.eventType && <span class="testimonial-type">{t.data.eventType}</span>}
                  </footer>
                </blockquote>
              );
            })}
          </SwipeCarousel>
        </div>
      </section>
    )
  }

  <!-- ======== SEE US IN ACTION ======== -->
  {showreelVideoId && (
    <section class="section" id="see-us">
      <div class="container">
        <SectionHeading title="Showreel" />
        <div class="video-container">
          <div class="video-embed">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${showreelVideoId}`}
              title="Mad Robin showreel"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ======== GALLERY ======== -->
  <section class="section" id="gallery">
    <div class="container">
      <SectionHeading title="Gallery" image={{ src: "/images/headings/gallery.png", width: 446, height: 180 }} />

      {showGalleryFilters && (
        <div class="filter-tabs" role="tablist" aria-label="Gallery categories">
          {galleryCategories.map((cat) => (
            <button
              role="tab"
              class:list={["filter-tab", { active: cat === "All" }]}
              data-category={cat}
              aria-selected={cat === "All" ? "true" : "false"}
            >
              {cat}
            </button>
          ))}
        </div>
      )}

      <div aria-live="polite" class="sr-only" id="gallery-status"></div>

      <SwipeCarousel
        id="gallery-grid"
        label="Gallery photos and videos"
        class="gallery-grid"
        desktopGrid="repeat(auto-fill, minmax(250px, 1fr))"
        cardMinWidth="85%"
      >
        {
          galleryItems.map((item) => (
                <a
                  href={item.data.image || "#"}
                  class:list={[
                    "gallery-item",
                    { "gallery-item--video": !!item.data.video },
                    { "gallery-item--video-only": !!item.data.video && !item.data.image },
                  ]}
                  data-category={item.data.category}
                  data-pswp-width={item.data.video && !item.data.image ? "1280" : ""}
                  data-pswp-height={item.data.video && !item.data.image ? "720" : ""}
                  {...(item.data.video ? { "data-video-src": item.data.video } : {})}
                >
                  {item.data.image ? (
                    <img
                      src={item.data.image}
                      alt={item.data.alt || item.data.title}
                      loading="lazy"
                      width="400"
                      height="300"
                    />
                  ) : (
                    <div class="gallery-video-placeholder">
                      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                        <line x1="7" y1="2" x2="7" y2="22"/>
                        <line x1="17" y1="2" x2="17" y2="22"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <line x1="2" y1="7" x2="7" y2="7"/>
                        <line x1="2" y1="17" x2="7" y2="17"/>
                        <line x1="17" y1="7" x2="22" y2="7"/>
                        <line x1="17" y1="17" x2="22" y2="17"/>
                      </svg>
                    </div>
                  )}
                  {item.data.video && (
                    <span class="gallery-play-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </span>
                  )}
                </a>
              ))
        }
        <button class="gallery-show-more" id="gallery-show-more" style="display:none" aria-label="Show all photos">
          Show all photos
        </button>
      </SwipeCarousel>
    </div>
  </section>

  <!-- ======== ABOUT THE BAND ======== -->
  <section class="section" id="about">
    <div class="container">
      <SectionHeading title="About the Band" />

      <SwipeCarousel id="carousel-members" label="Band members" desktopGrid="repeat(2, 1fr)" desktopGridLg="repeat(3, 1fr)" class="members-grid">
        {
          members.map(async (member) => {
            const { Content } = await render(member);
            return (
              <div class="member-card">
                {member.data.photo && (
                  <div class="member-photo">
                    <img
                      src={member.data.photo}
                      alt={`${member.data.name} — ${member.data.instrument}`}
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="member-info">
                  <h3>{member.data.name}</h3>
                  <p class="member-instrument">{member.data.instrument}</p>
                  <div class="member-bio">
                    <Content />
                  </div>
                </div>
              </div>
            );
          })
        }
      </SwipeCarousel>
    </div>
  </section>

  <!-- ======== FAQ ======== -->
  <section class="section" id="faq">
    {
      faqItems.length > 0 && (
        <div class="container container--narrow">
          <SectionHeading title="Frequently Asked Questions" />
          <div class="faq-list">
            {faqItems.map(async (item) => {
              const { Content } = await render(item);
              return (
                <details class="faq-item">
                  <summary class="faq-question">{item.data.question}</summary>
                  <div class="faq-answer">
                    <Content />
                  </div>
                </details>
              );
            })}
          </div>
        </div>
      )
    }
  </section>

</PageLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
  }

  .hero-bg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 1023px) {
    .hero-bg {
      height: var(--hero-h, 85svh);
      min-height: 240px;
      object-fit: cover;
      object-position: center 30%;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(45, 58, 45, 0) 0%,
      rgba(45, 58, 45, 0.12) 50%,
      rgba(45, 58, 45, 0.5) 100%
    );
    pointer-events: none;
  }

  .hero-logo-wrap {
    position: absolute;
    top: var(--space-lg);
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 2;
  }

  .hero-logo {
    width: clamp(100px, 14vw, 220px);
    height: auto;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  .hero-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
  }

  .hero-bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: var(--space-2xl);
  }

  /* Hero Enquire button: same width and text size, less height. */
  .hero-bottom-inner :global(.btn) {
    padding-block: 0.55rem;
  }

  .hero-tagline {
    font-size: var(--text-xl);
    color: var(--color-text-on-accent);
    max-width: 600px;
    margin: 0 auto var(--space-lg);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  /* ---- What We Do ---- */
  .welcome-text {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .welcome-text p {
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  /* ---- Video ---- */
  .video-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .video-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ---- Gallery ---- */
  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
    justify-content: center;
  }

  .filter-tab {
    padding: 0.5rem 1.2rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
    min-height: 44px;
  }

  .filter-tab:hover,
  .filter-tab.active {
    background-color: var(--color-accent-gold);
    border-color: var(--color-accent-gold);
    color: var(--color-text-on-accent);
  }

  .gallery-grid {
    gap: var(--space-md) !important;
  }

  .gallery-show-more {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    border: 1.5px dashed var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    width: 100%;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .gallery-show-more:hover {
    border-color: var(--color-accent-gold);
    color: var(--color-accent-gold);
  }

  .gallery-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    display: block;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
  }

  .gallery-play-icon svg {
    width: 48px;
    height: 48px;
    padding: 12px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.6);
    color: #fff;
    transition: background-color var(--transition-fast);
  }

  .gallery-item--video:hover .gallery-play-icon svg {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .gallery-video-placeholder {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }



  /* ---- Testimonials ---- */
  /* Desktop: centred rows, so a short last row sits in the middle.
     Phones: the SwipeCarousel's own swipe layout. */
  @media (min-width: 768px) {
    :global(#carousel-testimonials) {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .testimonial-card {
      flex: 0 1 calc((100% - 2 * var(--space-xl)) / 3);
      min-width: 260px;
    }
  }

  /* Plain: no box, no coloured edge, upright text (overrides the site-wide blockquote style). */
  .testimonial-card {
    margin: 0;
    padding: 0;
    border: 0;
    font-style: normal;
    text-align: center;
  }

  .testimonial-stars {
    flex-basis: 100%; /* rating on its own line, name and source below */
    color: #cf8471; /* softened version of the site red */
    letter-spacing: 0.1em;
  }

  .testimonial-quote {
    font-family: var(--font-accent);
    font-size-adjust: 0.5;
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .testimonial-quote :global(p) {
    color: var(--color-text-primary);
  }

  .testimonial-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    align-items: center;
    font-style: normal;
  }

  .testimonial-name {
    font-weight: 700;
    color: var(--color-text-primary);
    font-style: normal;
  }

  .testimonial-venue,
  .testimonial-type {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .testimonial-venue::before,
  .testimonial-type::before {
    content: "\00B7";
    margin-right: var(--space-sm);
