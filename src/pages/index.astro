<script>
  // Lock hero height as a pixel value so mobile address-bar show/hide can't
  // resize it. Recalculate when the width changes (window resized, phone
  // rotated) but not when only the height does (address bar).
  (function () {
    const mq = window.matchMedia("(max-width: 1023px)");
    const root = document.documentElement.style;
    let lastWidth = 0;
    function lock() {
      if (!mq.matches) {
        root.removeProperty("--hero-h");
        return;
      }
      const h = window.innerHeight;
      if (!h) return; // no height yet (e.g. a background tab); keep the CSS fallback
      root.setProperty("--hero-h", Math.round(h * 0.85) + "px");
      lastWidth = window.innerWidth;
    }
    lock();
    mq.addEventListener("change", lock);
    window.addEventListener("resize", () => {
      if (window.innerWidth !== lastWidth) lock();
    });
    if (screen.orientation) {
      screen.orientation.addEventListener("change", lock);
    } else {
      window.addEventListener("orientationchange", lock);
    }
  })();
</script>

<script>
  // PhotoSwipe lightbox with video support
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#gallery-grid',
    children: 'a.gallery-item',
    pswpModule: () => import('photoswipe'),
  });

  // Detect real image dimensions so portrait images aren't stretched
  lightbox.addFilter('itemData', (itemData, index) => {
    const el = itemData.element as HTMLElement;

    // Video items: use video content type
    if (el?.dataset.videoSrc) {
      return {
        ...itemData,
        type: 'video',
        videoSrc: el.dataset.videoSrc,
        width: 1280,
        height: 720,
      };
    }

    // Image items (including those with a video): read natural size
    const img = el?.querySelector('img') as HTMLImageElement | null;
    if (img && img.naturalWidth && img.naturalHeight) {
      itemData.width = img.naturalWidth;
      itemData.height = img.naturalHeight;
    }

    return itemData;
  });

  lightbox.on('contentLoad', (e) => {
    const { content } = e;
    if (content.data.type !== 'video') return;

    e.preventDefault();

    const container = document.createElement('div');
    container.style.width = '100%';
    container.style.height = '100%';
    container.style.display = 'flex';
    container.style.alignItems = 'center';
    container.style.justifyContent = 'center';
    container.style.background = '#000';

    const video = document.createElement('video');
    video.src = content.data.videoSrc;
    video.autoplay = false;
    video.controls = true;
    video.playsInline = true;
    video.style.width = '100%';
    video.style.height = '100%';
    video.style.objectFit = 'contain';

    container.appendChild(video);
    content.element = container;
  });

  function playVideo(video: HTMLVideoElement) {
    const attempt = () => video.play().catch(() => {});
    // On mobile the video element may not have buffered data yet when the
    // slide activates — wait for canplay rather than calling play() blind
    if (video.readyState >= 2) {
      attempt();
    } else {
      video.addEventListener('canplay', attempt, { once: true });
    }
  }

  lightbox.on('contentActivate', ({ content }) => {
    const video = content.element?.querySelector('video') as HTMLVideoElement | null;
    if (video) playVideo(video);
  });

  lightbox.on('contentDeactivate', ({ content }) => {
    // Pause only this slide's video — pauseAllVideos() would also pause
    // preloaded adjacent slides and race with the next contentActivate
    const video = content.element?.querySelector('video') as HTMLVideoElement | null;
    if (video) video.pause();
  });

  const pauseAll = () => document.querySelectorAll('video').forEach((v) => (v as HTMLVideoElement).pause());
  lightbox.on('close', pauseAll);
  lightbox.on('destroy', pauseAll);

  lightbox.init();
</script>

<script>
  // Load live availability badges on event cards
  document.querySelectorAll<HTMLElement>(".event-availability").forEach(async (el) => {
    const slug = el.dataset.slug;
    if (!slug) return;
    try {
      const res = await fetch(`/api/event-availability?slug=${slug}`);
      const data = await res.json();
      if (data.status === "low") {
        el.textContent = `Only ${data.remaining} tickets left`;
        el.className = "event-availability event-availability--low";
      } else if (data.status === "sold_out") {
        el.textContent = "Sold out";
        el.className = "event-availability event-availability--soldout";
      }
    } catch {
      // Silently fail — availability badge is non-critical
    }
  });
</script>

<script>
  const desktopMq = window.matchMedia("(min-width: 768px)");
  const showMoreBtn = document.getElementById("gallery-show-more") as HTMLElement;
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-tab"));
  const items = Array.from(document.querySelectorAll<HTMLElement>(".gallery-item"));
  const statusEl = document.getElementById("gallery-status");

  // Hide filter tabs for categories with no content
  const populated = new Set(items.map(el => el.dataset.category));
  tabs.forEach(tab => {
    if (tab.dataset.category !== "All" && !populated.has(tab.dataset.category)) {
      tab.style.display = "none";
    }
  });

  function getColumnCount(): number {
    const visible = items.filter(el => el.style.display !== "none");
    if (visible.length < 2) return 1;
    const firstTop = visible[0].getBoundingClientRect().top;
    if (firstTop === 0) return 3;
    let cols = 0;
    for (const el of visible) {
      if (Math.abs(el.getBoundingClientRect().top - firstTop) < 5) cols++;
      else break;
    }
    return Math.max(cols, 1);
  }

  function applyTruncation() {
    if (!desktopMq.matches) {
      items.forEach(el => { el.style.display = ""; });
      showMoreBtn.style.display = "none";
      return;
    }
    items.forEach(el => { el.style.display = ""; });
    showMoreBtn.style.display = "none";

    const cols = getColumnCount();
    const threshold = cols * 3 - 1;
    if (items.length <= threshold) return;

    items.forEach((el, i) => { el.style.display = i < threshold ? "" : "none"; });
    showMoreBtn.style.display = "";
    document.dispatchEvent(new CustomEvent("carousel:update"));
  }

  requestAnimationFrame(() => applyTruncation());

  desktopMq.addEventListener("change", () => {
    const activeCategory = tabs.find(t => t.classList.contains("active"))?.dataset.category ?? "All";
    if (activeCategory === "All") applyTruncation();
    else {
      items.forEach(el => { el.style.display = ""; });
      showMoreBtn.style.display = "none";
    }
    document.dispatchEvent(new CustomEvent("carousel:update"));
  });

  showMoreBtn.addEventListener("click", () => {
    items.forEach(el => { el.style.display = ""; });
    showMoreBtn.style.display = "none";
    document.dispatchEvent(new CustomEvent("carousel:update"));
  });

  tabs.forEach(tab => {
    tab.addEventListener("click", () => {
      const category = tab.dataset.category!;
      tabs.forEach(t => { t.classList.remove("active"); t.setAttribute("aria-selected", "false"); });
      tab.classList.add("active");
      tab.setAttribute("aria-selected", "true");

      if (category === "All") {
        applyTruncation();
        if (statusEl) statusEl.textContent = "";
      } else {
        showMoreBtn.style.display = "none";
        let count = 0;
        items.forEach(el => {
          const show = el.dataset.category === category;
          el.style.display = show ? "" : "none";
          if (show) count++;
        });
        if (statusEl) statusEl.textContent = `Showing ${count} ${category.toLowerCase()} photo${count !== 1 ? "s" : ""}`;
        document.dispatchEvent(new CustomEvent("carousel:update"));
      }
    });
  });
</script>
