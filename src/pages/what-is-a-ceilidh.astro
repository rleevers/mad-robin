---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Button from "@/components/ui/Button.astro";
import { getCollection, render } from "astro:content";

const allFaq = await getCollection("faq");
const faqItems = allFaq.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const title = "What is a Ceilidh? — Mad Robin Ceilidh Band";
const description =
  "A ceilidh (pronounced KAY-lee) is a social gathering with traditional folk music and called dancing. No experience needed! Learn more about what to expect.";

// Build FAQPage JSON-LD — render each FAQ's markdown to plain text
const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: await Promise.all(
    faqItems.map(async (item) => {
      const { Content } = await render(item);
      return {
        "@type": "Question",
        name: item.data.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.body || "",
        },
      };
    })
  ),
});
---

<PageLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={faqJsonLd} />
  <!-- ======== INTRO ======== -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHeading
        tag="h1"
        title="What is a Ceilidh?"
        subtitle="Everything you need to know about ceilidh dancing"
      />

      <div class="intro-text">
        <p class="pronunciation">
          <strong>Ceilidh</strong> — pronounced <em>"KAY-lee"</em>
        </p>
        <p>
          A ceilidh is a social gathering with live folk music and group
          dancing. It's one of the most inclusive and joyful forms of
          entertainment you can have at an event — everyone dances, from
          children to grandparents, and no experience is needed whatsoever.
        </p>
        <p>
          The word "ceilidh" comes from the Gaelic for "a visit" or "social
          gathering." While the tradition has its roots in Scotland and Ireland,
          English ceilidh (sometimes called "barn dances") draws on a rich
          tradition of English country dance that goes back centuries.
        </p>
        <p>
          At a Mad Robin ceilidh, our caller talks everyone through every
          dance before the music starts. The dances involve simple, repeating
          patterns — forming circles, swinging partners, weaving down the
          line — and within minutes, everyone's laughing and spinning around
          the floor.
        </p>
      </div>
    </div>
  </section>

  <!-- ======== WHAT TO EXPECT ======== -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <SectionHeading title="What to Expect" />
      <div class="expect-grid">
        <div class="expect-item">
          <h3>The Caller</h3>
          <p>
            Before each dance, the caller explains the moves and walks everyone
            through a practice run. Then the music starts, and the caller keeps
            prompting until everyone's got it. It's fun, friendly, and nobody
            gets left behind.
          </p>
        </div>
        <div class="expect-item">
          <h3>The Dances</h3>
          <p>
            Expect classics like Strip the Willow, Gay Gordons, Virginia Reel,
            and many more. The dances are sociable — you'll dance with lots of
            different people throughout the evening, not just your partner.
          </p>
        </div>
        <div class="expect-item">
          <h3>The Music</h3>
          <p>
            Live, energetic folk music played on fiddle, accordion, guitar, and
            bass. The tempo builds throughout the evening, and the energy is
            infectious. It's impossible not to tap your feet.
          </p>
        </div>
        <div class="expect-item">
          <h3>What to Wear</h3>
          <p>
            Wear whatever's comfortable — you'll be moving around! Flat shoes
            or trainers are recommended. Ceilidh dancing can be quite energetic,
            so layers are a good idea too.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== VIDEO PLACEHOLDER ======== -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHeading title="See a Ceilidh in Action" />
      <div class="video-placeholder">
        <div class="video-placeholder-inner">
          <span class="video-play-icon" aria-hidden="true">▶</span>
          <p>Video coming soon</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== FAQ ======== -->
  {
    faqItems.length > 0 && (
      <section class="section section--warm">
        <div class="container container--narrow">
          <SectionHeading title="Frequently Asked Questions" />
          <div class="faq-list">
            {faqItems.map(async (item) => {
              const { Content } = await render(item);
              return (
                <details class="faq-item">
                  <summary class="faq-question">{item.data.question}</summary>
                  <div class="faq-answer">
                    <Content />
                  </div>
                </details>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- ======== CTA ======== -->
  <section class="cta-banner">
    <div class="container cta-banner-inner">
      <h2>Ready to try a ceilidh?</h2>
      <p>Book Mad Robin for your event, or come along to one of our public ceilidhs.</p>
      <div class="cta-buttons">
        <Button href="/book-us/" size="lg" variant="outline">Book Us</Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* ---- Intro ---- */
  .intro-text {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .intro-text p {
    font-size: var(--text-lg);
    line-height: 1.8;
  }

  .pronunciation {
    font-size: var(--text-2xl) !important;
    font-family: var(--font-heading);
    color: var(--color-text-primary);
    margin-bottom: var(--space-xl) !important;
  }

  .pronunciation em {
    color: var(--color-accent-gold);
  }

  /* ---- What to expect ---- */
  .expect-grid {
    display: grid;
    gap: var(--space-xl);
  }

  .expect-item {
    padding: var(--space-lg);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .expect-item h3 {
    color: var(--color-accent-gold);
    margin-bottom: var(--space-sm);
    font-size: var(--text-lg);
  }

  .expect-item p {
    font-size: var(--text-sm);
    margin: 0;
  }

  /* ---- Video placeholder ---- */
  .video-placeholder {
    aspect-ratio: 16 / 9;
    background: linear-gradient(
      135deg,
      var(--color-bg-tertiary),
      var(--color-bg-primary)
    );
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-placeholder-inner {
    text-align: center;
  }

  .video-play-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-md);
    border-radius: 50%;
    background-color: var(--color-accent-gold);
    color: var(--color-text-on-accent);
    font-size: 1.5rem;
    opacity: 0.6;
  }

  .video-placeholder p {
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
  }

  /* ---- FAQ accordion ---- */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .faq-item {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] {
    border-color: var(--color-accent-gold);
  }

  .faq-question {
    padding: var(--space-lg);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .faq-question::before {
    content: "+";
    margin-right: var(--space-md);
    font-size: var(--text-xl);
    color: var(--color-accent-gold);
    font-weight: 700;
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .faq-item[open] .faq-question::before {
    content: "−";
  }

  .faq-answer {
    padding: 0 var(--space-lg) var(--space-lg);
    padding-left: calc(var(--space-lg) + var(--text-xl) + var(--space-md));
  }

  .faq-answer :global(p) {
    font-size: var(--text-base);
    line-height: 1.7;
  }

  /* ---- CTA Banner ---- */
  .cta-banner {
    background: linear-gradient(
      135deg,
      var(--color-accent-gold),
      var(--color-accent-terracotta)
    );
    padding: var(--space-4xl) 0;
  }

  .cta-banner-inner {
    text-align: center;
  }

  .cta-banner h2 {
    color: var(--color-text-on-accent);
    margin-bottom: var(--space-md);
  }

  .cta-banner p {
    color: var(--color-text-on-accent-muted);
    font-size: var(--text-lg);
    margin-bottom: var(--space-xl);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-banner :global(.btn--outline) {
    border-color: var(--color-text-on-accent);
    color: var(--color-text-on-accent);
  }

  .cta-banner :global(.btn--outline:hover) {
    background-color: var(--color-text-on-accent);
    color: var(--color-accent-gold);
  }

  /* ---- Responsive ---- */
  @media (min-width: 768px) {
    .expect-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
