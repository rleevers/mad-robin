---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import SwipeCarousel from "@/components/ui/SwipeCarousel.astro";
import PlaceholderImage from "@/components/ui/PlaceholderImage.astro";
import { getCollection } from "astro:content";

const galleryCategories = ["All", "Weddings", "Barn Dances", "Private", "Public"];
const allGallery = await getCollection("gallery");
const galleryItems = allGallery.sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const title = "Gallery — Mad Robin Ceilidh Band";
const description =
  "Photos and videos from Mad Robin's ceilidhs, weddings, barn dances and private events in Devon and the Southwest.";
---

<PageLayout title={title} description={description}>
  <section class="section" id="gallery">
    <div class="container">
      <SectionHeading title="Gallery" subtitle="Photos and videos from our events" />

      <!-- Category filter tabs -->
      <div class="filter-tabs" role="tablist" aria-label="Gallery categories">
        {
          galleryCategories.map((cat) => (
            <button
              role="tab"
              class:list={["filter-tab", { active: cat === "All" }]}
              data-category={cat}
              aria-selected={cat === "All" ? "true" : "false"}
            >
              {cat}
            </button>
          ))
        }
      </div>

      <div aria-live="polite" class="sr-only" id="gallery-status"></div>

      <SwipeCarousel
        id="gallery-grid"
        label="Gallery photos and videos"
        class="gallery-grid"
        desktopGrid="repeat(auto-fill, minmax(250px, 1fr))"
        cardMinWidth="85%"
      >
        {
          galleryItems.length > 0
            ? galleryItems.map((item) => (
                <a
                  href={item.data.image || "#"}
                  class:list={[
                    "gallery-item",
                    { "gallery-item--video": !!item.data.video },
                    { "gallery-item--video-only": !!item.data.video && !item.data.image },
                  ]}
                  data-category={item.data.category}
                  data-pswp-width={item.data.video && !item.data.image ? "1280" : ""}
                  data-pswp-height={item.data.video && !item.data.image ? "720" : ""}
                  {...(item.data.video ? { "data-video-src": item.data.video } : {})}
                >
                  {item.data.image ? (
                    <img
                      src={item.data.image}
                      alt="Gallery photo"
                      loading="lazy"
                      width="400"
                      height="300"
                    />
                  ) : (
                    <div class="gallery-video-placeholder">
                      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                        <line x1="7" y1="2" x2="7" y2="22"/>
                        <line x1="17" y1="2" x2="17" y2="22"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <line x1="2" y1="7" x2="7" y2="7"/>
                        <line x1="2" y1="17" x2="7" y2="17"/>
                        <line x1="17" y1="7" x2="22" y2="7"/>
                        <line x1="17" y1="17" x2="22" y2="17"/>
                      </svg>
                    </div>
                  )}
                  {item.data.video && (
                    <span class="gallery-play-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </span>
                  )}
                </a>
              ))
            : Array.from({ length: 9 }).map((_, i) => (
                <div class="gallery-placeholder-card" data-category="All">
                  <PlaceholderImage
                    alt={`Gallery photo coming soon ${i + 1}`}
                    aspectRatio="4 / 3"
                    icon="📷"
                  />
                </div>
              ))
        }
      </SwipeCarousel>
    </div>
  </section>
</PageLayout>

<style>
  :global(.filter-tabs) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-bottom: var(--space-2xl);
  }

  :global(.filter-tab) {
    padding: 0.5rem 1.2rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
    min-height: 44px;
  }

  :global(.filter-tab:hover),
  :global(.filter-tab.active) {
    background-color: var(--color-accent-gold);
    border-color: var(--color-accent-gold);
    color: var(--color-text-on-accent);
  }

  .gallery-grid {
    gap: var(--space-md);
  }

  .gallery-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    display: block;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
  }

  .gallery-play-icon svg {
    width: 48px;
    height: 48px;
    padding: 12px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.6);
    color: #fff;
    transition: background-color var(--transition-fast);
  }

  .gallery-item--video:hover .gallery-play-icon svg {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .gallery-video-placeholder {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }

  .gallery-placeholder-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px dashed var(--color-border);
  }
</style>

<script>
  // Gallery category filtering
  const tabs = document.querySelectorAll<HTMLButtonElement>(".filter-tab");
  const items = document.querySelectorAll<HTMLElement>(".gallery-item, .gallery-placeholder-card");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const category = tab.dataset.category;

      tabs.forEach((t) => {
        t.classList.remove("active");
        t.setAttribute("aria-selected", "false");
      });
      tab.classList.add("active");
      tab.setAttribute("aria-selected", "true");

      let visibleCount = 0;
      items.forEach((item) => {
        if (category === "All" || item.dataset.category === category) {
          item.style.display = "";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      const status = document.getElementById("gallery-status");
      if (status) {
        status.textContent = `Showing ${visibleCount} photo${visibleCount !== 1 ? "s" : ""} for ${category}`;
      }

      document.dispatchEvent(new CustomEvent("carousel:update"));
    });
  });
</script>

<script>
  // PhotoSwipe lightbox with video support
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#gallery-grid",
    children: "a.gallery-item",
    pswpModule: () => import("photoswipe"),
  });

  lightbox.addFilter("itemData", (itemData, index) => {
    const el = itemData.element as HTMLElement;

    if (el?.dataset.videoSrc) {
      return {
        ...itemData,
        type: "video",
        videoSrc: el.dataset.videoSrc,
        width: 1280,
        height: 720,
      };
    }

    const img = el?.querySelector("img") as HTMLImageElement | null;
    if (img && img.naturalWidth && img.naturalHeight) {
      itemData.width = img.naturalWidth;
      itemData.height = img.naturalHeight;
    }

    return itemData;
  });

  lightbox.on("contentLoad", (e) => {
    const { content } = e;
    if (content.data.type !== "video") return;

    e.preventDefault();

    const container = document.createElement("div");
    container.style.width = "100%";
    container.style.height = "100%";
    container.style.display = "flex";
    container.style.alignItems = "center";
    container.style.justifyContent = "center";
    container.style.background = "#000";

    const video = document.createElement("video");
    video.src = content.data.videoSrc;
    video.autoplay = false;
    video.controls = true;
    video.playsInline = true;
    video.style.width = "100%";
    video.style.height = "100%";
    video.style.objectFit = "contain";

    container.appendChild(video);
    content.element = container;
  });

  lightbox.on("contentActivate", ({ content }) => {
    const video = content.element?.querySelector("video");
    if (video) video.play();
  });

  function pauseAllVideos() {
    document.querySelectorAll("video").forEach((v) => {
      (v as HTMLVideoElement).pause();
    });
  }

  lightbox.on("contentDeactivate", () => pauseAllVideos());
  lightbox.on("close", () => pauseAllVideos());
  lightbox.on("destroy", () => pauseAllVideos());

  lightbox.init();
</script>
