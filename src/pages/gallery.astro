---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { getCollection, render } from "astro:content";

const allGallery = await getCollection("gallery");
const galleryItems = allGallery.sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder
);

const allTestimonials = await getCollection("testimonials");
const testimonials = allTestimonials.slice(0, 6);

const categories = ["All", "Weddings", "Barn Dances", "Corporate", "Public"];

const title = "Gallery & Reviews — Mad Robin Ceilidh Band";
const description =
  "See photos from Mad Robin ceilidh events and read reviews from happy clients across Devon and the Southwest.";
---

<PageLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <SectionHeading
        tag="h1"
        title="Gallery & Reviews"
        subtitle="Photos and kind words from our events"
      />

      <!-- Category filter tabs -->
      <div class="filter-tabs" role="tablist" aria-label="Gallery categories">
        {
          categories.map((cat) => (
            <button
              role="tab"
              class:list={["filter-tab", { active: cat === "All" }]}
              data-category={cat}
              aria-selected={cat === "All" ? "true" : "false"}
            >
              {cat}
            </button>
          ))
        }
      </div>

      <!-- Gallery grid -->
      <div class="gallery-grid" id="gallery-grid">
        {
          galleryItems.map((item) => (
            <a
              href={item.data.image}
              class="gallery-item"
              data-pswp-width="1200"
              data-pswp-height="800"
              data-category={item.data.category}
              target="_blank"
            >
              <img
                src={item.data.image}
                alt={item.data.alt}
                loading="lazy"
                width="400"
                height="300"
              />
              {item.data.caption && (
                <span class="gallery-caption">{item.data.caption}</span>
              )}
            </a>
          ))
        }

        {
          galleryItems.length === 0 && (
            <div class="gallery-placeholder">
              <p>Gallery coming soon — check back after our next events!</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  {
    testimonials.length > 0 && (
      <section class="section section--warm">
        <div class="container">
          <SectionHeading title="What People Say" />
          <div class="testimonials-grid">
            {testimonials.map(async (t) => {
              const { Content } = await render(t);
              return (
                <blockquote class="testimonial-card">
                  <div class="testimonial-quote">
                    <Content />
                  </div>
                  <footer class="testimonial-footer">
                    <cite class="testimonial-name">{t.data.clientName}</cite>
                    {t.data.venue && (
                      <span class="testimonial-detail">{t.data.venue}</span>
                    )}
                    <span class="testimonial-detail">{t.data.eventType}</span>
                  </footer>
                </blockquote>
              );
            })}
          </div>
        </div>
      </section>
    )
  }
</PageLayout>

<style>
  /* ---- Filter tabs ---- */
  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-bottom: var(--space-2xl);
  }

  .filter-tab {
    padding: 0.5rem 1.2rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
    min-height: 44px;
  }

  .filter-tab:hover,
  .filter-tab.active {
    background-color: var(--color-accent-gold);
    border-color: var(--color-accent-gold);
    color: var(--color-text-on-accent);
  }

  /* ---- Gallery grid ---- */
  .gallery-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }

  .gallery-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    display: block;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-sm) var(--space-md);
    background: linear-gradient(transparent, var(--color-overlay));
    color: var(--color-text-primary);
    font-size: var(--text-xs);
  }

  .gallery-placeholder {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-4xl);
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border);
  }

  .gallery-placeholder p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  /* ---- Testimonials ---- */
  .testimonials-grid {
    display: grid;
    gap: var(--space-xl);
  }

  .testimonial-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    border-left: 3px solid var(--color-accent-gold);
  }

  .testimonial-quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .testimonial-quote :global(p) {
    color: var(--color-text-primary);
  }

  .testimonial-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-style: normal;
  }

  .testimonial-name {
    font-weight: 700;
    color: var(--color-accent-gold);
    font-style: normal;
  }

  .testimonial-detail {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .testimonial-detail::before {
    content: "·";
    margin-right: var(--space-sm);
  }

  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  // Gallery category filtering
  const tabs = document.querySelectorAll<HTMLButtonElement>(".filter-tab");
  const items = document.querySelectorAll<HTMLElement>(".gallery-item");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const category = tab.dataset.category;

      tabs.forEach((t) => {
        t.classList.remove("active");
        t.setAttribute("aria-selected", "false");
      });
      tab.classList.add("active");
      tab.setAttribute("aria-selected", "true");

      items.forEach((item) => {
        if (category === "All" || item.dataset.category === category) {
          item.style.display = "";
        } else {
          item.style.display = "none";
        }
      });
    });
  });
</script>
