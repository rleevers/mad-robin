---
import PageLayout from "@/layouts/PageLayout.astro";
import Button from "@/components/ui/Button.astro";
---

<PageLayout
  title="Enquiry Sent — Mad Robin Ceilidh Band"
  description="Thank you for your enquiry. We'll be in touch within 24 hours."
  noindex={true}
>
  <section class="success-section">
    <div class="container container--narrow success-inner">
      <div class="success-icon" aria-hidden="true">✓</div>
      <h1>Thank you!</h1>
      <p>Your enquiry has been sent. We'll get back to you within 24 hours.</p>
      <p class="success-sub">
        In the meantime, feel free to explore our site or drop us an email at
        <a href="mailto:madrobinband@gmail.com">madrobinband@gmail.com</a>.
      </p>
      <Button href="/">Back to Home</Button>
    </div>
  </section>
</PageLayout>

<style>
  .success-section {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }

  .success-inner {
    text-align: center;
    padding-block: var(--space-4xl);
  }

  .success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    margin: 0 auto var(--space-xl);
    border-radius: 50%;
    background-color: var(--color-success);
    color: var(--color-text-on-accent);
    font-size: 2rem;
    font-weight: 700;
  }

  h1 {
    color: var(--color-accent-gold);
    margin-bottom: var(--space-md);
  }

  p {
    font-size: var(--text-lg);
  }

  .success-sub {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }
</style>
