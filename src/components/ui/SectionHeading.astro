---
/* ============================================
   SectionHeading — Heading + subtitle
   ============================================ */

interface Props {
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  tag?: "h1" | "h2" | "h3";
  /** Hand-lettered image to show instead of the typed title (title stays as its alt text). */
  image?: { src: string; width: number; height: number };
}

const { title, subtitle, align = "center", tag: Tag = "h2", image } = Astro.props;
---

<div class:list={["section-heading", `section-heading--${align}`]}>
  <Tag>
    {image ? (
      <img src={image.src} alt={title} width={image.width} height={image.height} class="heading-lettering" />
    ) : (
      title
    )}
  </Tag>
  <span class="accent-line" aria-hidden="true"></span>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: var(--space-xl);
  }

  .section-heading--center {
    text-align: center;
  }

  .section-heading--left {
    text-align: left;
  }

  /* A touch larger than the typed headings: 1.25em of the heading's font size. */
  .heading-lettering {
    display: inline-block;
    height: 1.25em;
    width: auto;
    vertical-align: bottom;
  }

  /* Placeholder: to be replaced with a sketch of a twig. */
  .accent-line {
    display: block;
    width: 60px;
    height: 3px;
    background-color: var(--color-accent-gold);
    margin-top: var(--space-md);
    border-radius: var(--radius-full);
  }

  .section-heading--center .accent-line {
    margin-inline: auto;
  }

  .subtitle {
    margin-top: var(--space-md);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  .section-heading--center .subtitle {
    margin-inline: auto;
  }
</style>
