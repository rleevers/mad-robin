---
/* ============================================
   Footer — CTA strip, links, contact, copyright
   ============================================ */

import Button from "@/components/ui/Button.astro";

const SOCIALS = [
  { label: "Facebook", href: "https://facebook.com/madrobinband", icon: "facebook" },
  { label: "Instagram", href: "https://www.instagram.com/madrobinband/", icon: "instagram" },
  { label: "YouTube", href: "https://youtube.com/@madrobinband", icon: "youtube" },
];

const currentPath = Astro.url.pathname;
---

<footer class="site-footer">
  <!-- Mini CTA strip -->
  <div class="footer-cta">
    <div class="container footer-cta-inner">
      <p class="footer-cta-text">
        Ready to get your guests on the dance floor?
      </p>
      <Button href="/book-us/" {...(currentPath.startsWith("/book-us/") ? { "aria-current": "page" } : {})}>Book Us</Button>
    </div>
  </div>

  <div class="footer-main">
    <div class="container footer-grid">
      <!-- Brand -->
      <div class="footer-col">
        <p class="footer-brand">Mad Robin</p>
        <p class="footer-tagline">
          Live English ceilidh music for weddings, parties & events in Devon and
          the Southwest.
        </p>
        <div class="footer-socials">
          {SOCIALS.map((s) => (
            <a href={s.href} class="social-link" aria-label={s.label} target="_blank" rel="noopener noreferrer">
              {s.icon === "facebook" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              )}
              {s.icon === "instagram" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              )}
              {s.icon === "youtube" && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Quick links -->
      <div class="footer-col">
        <h4 class="footer-heading">Quick Links</h4>
        <nav aria-label="Footer navigation">
          <a href="/#what-we-do" class="footer-link" {...(currentPath === "/" ? { "aria-current": "page" } : {})}>What We Do</a>
          <a href="/#gallery" class="footer-link" {...(currentPath === "/" ? { "aria-current": "page" } : {})}>Gallery</a>
          <a href="/#about" class="footer-link" {...(currentPath === "/" ? { "aria-current": "page" } : {})}>About the Band</a>
          <a href="/#what-is-a-ceilidh" class="footer-link" {...(currentPath === "/" ? { "aria-current": "page" } : {})}>What is a Ceilidh?</a>
          <a href="/book-us/" class="footer-link" {...(currentPath.startsWith("/book-us/") ? { "aria-current": "page" } : {})}>Book Us</a>
        </nav>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h4 class="footer-heading">Get in Touch</h4>
        <address class="footer-contact">
          <a href="mailto:madrobinband@gmail.com" class="footer-link">madrobinband@gmail.com</a>
          <a href="tel:+447849035551" class="footer-link">+44 7849 035551</a>
          <p class="footer-small">Please leave a message</p>
          <p class="footer-small">We respond within 24 hours</p>
        </address>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {new Date().getFullYear()} Mad Robin Band. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
  }

  /* CTA strip */
  .footer-cta {
    background-color: var(--color-accent-gold);
    padding: var(--space-xl) 0;
  }

  .footer-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .footer-cta-text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text-on-accent);
    margin: 0;
    font-weight: 600;
  }

  .footer-cta :global(.btn--primary) {
    background-color: var(--color-text-on-accent);
    color: var(--color-accent-gold);
  }

  .footer-cta :global(.btn--primary:hover) {
    background-color: var(--color-bg-primary);
  }

  /* Main footer */
  .footer-main {
    background-color: var(--color-bg-secondary);
    padding: var(--space-3xl) 0;
  }

  .footer-grid {
    display: grid;
    gap: var(--space-2xl);
  }

  .footer-brand {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
  }

  .footer-tagline {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .footer-socials {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .footer-socials .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-muted);
    border-radius: var(--radius-full);
    transition: color var(--transition-fast);
  }

  .footer-socials .social-link:hover {
    color: var(--color-accent-gold);
  }

  .footer-heading {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-gold);
    margin-bottom: var(--space-md);
  }

  .footer-col nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-link {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-accent-gold);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-style: normal;
  }

  .footer-small {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  /* Bottom bar */
  .footer-bottom {
    background-color: var(--color-bg-footer-bottom);
    padding: var(--space-md) 0;
  }

  .footer-bottom-inner {
    text-align: center;
  }

  .footer-bottom p {
    font-size: var(--text-xs);
    color: #9aaa98;
    margin: 0;
  }

  @media (min-width: 768px) {
    .footer-cta-inner {
      flex-direction: row;
      justify-content: center;
    }

    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
