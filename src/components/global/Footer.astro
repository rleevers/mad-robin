---
/* ============================================
   Footer — CTA strip, links, contact, copyright
   ============================================ */

import siteSettings from "@/data/settings/site.yml";

// Hand-drawn icons, shown at the sizes they were drawn relative to each other.
const ICON_SIZE: Record<string, { w: number; h: number }> = {
  facebook: { w: 27, h: 28 },
  instagram: { w: 25, h: 25 },
  youtube: { w: 25, h: 18 },
};

const links = siteSettings.socialLinks;
const SOCIALS = [
  ...(links.facebook ? [{ label: "Facebook", href: links.facebook, icon: "facebook" }] : []),
  ...(links.instagram ? [{ label: "Instagram", href: links.instagram, icon: "instagram" }] : []),
  ...(links.youtube ? [{ label: "YouTube", href: links.youtube, icon: "youtube" }] : []),
];

const currentPath = Astro.url.pathname;
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="container footer-grid">
      <!-- Brand -->
      <div class="footer-col">
        <p class="footer-brand">Mad Robin</p>
        <p class="footer-tagline">
          Based in Exeter, Devon. We cover the Southwest.
        </p>
        <div class="footer-socials">
          {SOCIALS.map((s) => (
            <a href={s.href} class="social-link" aria-label={s.label} target="_blank" rel="noopener noreferrer">
              <img
            src={`/images/social/${s.icon}.png`}
            alt=""
            width={ICON_SIZE[s.icon].w}
            height={ICON_SIZE[s.icon].h}
            class="social-icon"
          />
            </a>
          ))}
        </div>
      </div>

      <!-- Quick links -->
      <div class="footer-col">
        <h4 class="footer-heading">Quick Links</h4>
        <nav aria-label="Footer navigation">
          <a href="/#gallery" class="footer-link" {...(currentPath === "/" ? { "aria-current": "page" } : {})}>Gallery</a>
          <a href="/#about" class="footer-link" {...(currentPath === "/" ? { "aria-current": "page" } : {})}>About the Band</a>
          <a href="/#faq" class="footer-link" {...(currentPath === "/" ? { "aria-current": "page" } : {})}>FAQ</a>
          <a href="/book-us/" class="footer-link" {...(currentPath.startsWith("/book-us/") ? { "aria-current": "page" } : {})}>Book Us</a>
        </nav>
      </div>

      <!-- Contact -->
      <div class="footer-col">
        <h4 class="footer-heading">Get in Touch</h4>
        <address class="footer-contact">
          <a href={`mailto:${siteSettings.email}`} class="footer-link">{siteSettings.email}</a>
          <a href={`tel:${siteSettings.phone.replace(/\s/g, "")}`} class="footer-link">{siteSettings.phone}</a>
        </address>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {new Date().getFullYear()} Mad Robin Band. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
  }

  /* CTA strip */
  /* Main footer */
  .footer-main {
    background-color: var(--color-bg-secondary);
    padding: var(--space-3xl) 0;
  }

  .footer-grid {
    display: grid;
    gap: var(--space-2xl);
  }

  .footer-brand {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
  }

  .footer-tagline {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .footer-socials {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .footer-socials .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-muted);
    border-radius: var(--radius-full);
    transition: color var(--transition-fast);
  }

  .footer-socials .social-link:hover {
    color: var(--color-accent-gold);
  }

  .footer-heading {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-gold);
    margin-bottom: var(--space-md);
  }

  .footer-col nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-link {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-accent-gold);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-style: normal;
  }

  /* Bottom bar */
  .footer-bottom {
    background-color: var(--color-bg-footer-bottom);
    padding: var(--space-md) 0;
  }

  .footer-bottom-inner {
    text-align: center;
  }

  .footer-bottom p {
    font-size: var(--text-xs);
    color: #9aaa98;
    margin: 0;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .social-icon {
    display: block;
    transition: transform var(--transition-fast);
  }

  .social-link:hover .social-icon {
    transform: rotate(-6deg) scale(1.1);
  }
</style>
