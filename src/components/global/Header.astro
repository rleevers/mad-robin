---
/* ============================================
   Header — Sticky nav with mobile hamburger

   To activate hidden pages, add them to the
   NAV_ITEMS array below.
   ============================================ */

import { Image } from "astro:assets";
import robinLogo from "@/assets/images/robin.png";
import Button from "@/components/ui/Button.astro";
import siteSettings from "@/data/settings/site.yml";

const NAV_ITEMS = [
  { label: "What We Do", href: "/#what-we-do" },
  { label: "Gallery", href: "/gallery" },
  { label: "About", href: "/#about" },
  { label: "Events", href: "/#events" },
];

const CTA = { label: "Book Us", href: "/book-us/" };
const currentPath = Astro.url.pathname;

const headerLinks = siteSettings.socialLinks;
const SOCIALS = [
  ...(headerLinks.facebook ? [{ label: "Facebook", href: headerLinks.facebook, icon: "facebook" }] : []),
  ...(headerLinks.instagram ? [{ label: "Instagram", href: headerLinks.instagram, icon: "instagram" }] : []),
  ...(headerLinks.youtube ? [{ label: "YouTube", href: headerLinks.youtube, icon: "youtube" }] : []),
];
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <a href="/" class="logo" aria-label="Mad Robin — Home">
      <span class="logo-img-wrap">
        <Image src={robinLogo} alt="Mad Robin" class="logo-img" width={120} height={90} format="webp" quality={80} />
        <span class="easter-egg-tooltip" aria-hidden="true">The actual dance "Mad Robin" (Playford, 1687) is named after a wandering lunatic figure.</span>
      </span>
      <span class="logo-text">Mad Robin</span>
    </a>

    <!-- Social icons -->
    <div class="social-icons">
      {SOCIALS.map((s) => (
        <a href={s.href} class="social-link" aria-label={s.label} target="_blank" rel="noopener noreferrer">
          {s.icon === "facebook" && (
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          )}
          {s.icon === "instagram" && (
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          )}
          {s.icon === "youtube" && (
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          )}
        </a>
      ))}
    </div>

    <nav class="desktop-nav" aria-label="Main navigation">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            {...(item.href.startsWith("/#") && currentPath === "/" ? { "aria-current": "page" } : {})}
          >
            {item.label}
          </a>
        ))
      }
      <Button
        href={CTA.href}
        size="sm"
        {...(currentPath.startsWith(CTA.href) ? { "aria-current": "page" } : {})}
      >{CTA.label}</Button>
    </nav>

    <button
      class="hamburger"
      id="hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

      <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
        {
          NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class="mobile-link"
              {...(item.href.startsWith("/#") && currentPath === "/" ? { "aria-current": "page" } : {})}
            >
              {item.label}
            </a>
          ))
        }
        <Button
          href={CTA.href}
          class="mobile-cta"
          {...(currentPath.startsWith(CTA.href) ? { "aria-current": "page" } : {})}
        >{CTA.label}</Button>
      </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg-primary-95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .logo-img-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .logo-img {
    height: 36px;
    width: auto;
    object-fit: contain;
  }

  .easter-egg-tooltip {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 240px;
    padding: 10px 12px;
    background-color: var(--color-bg-footer-bottom);
    color: var(--color-text-on-accent);
    font-family: var(--font-body);
    font-size: 12px;
    font-style: italic;
    line-height: 1.5;
    border-radius: var(--radius-md);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 200;
  }

  .logo-img-wrap:hover .easter-egg-tooltip {
    opacity: 1;
    transition-delay: 3s;
  }

  /* Social icons */
  .social-icons {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-muted);
    border-radius: var(--radius-full);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .social-link:hover {
    color: var(--color-accent-gold);
  }

/* Desktop nav */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-link {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent-gold);
  }

  /* Hamburger button */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text-primary);
    transition: transform var(--transition-base), opacity var(--transition-base);
    pointer-events: none;
  }

  .hamburger.is-open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile nav */
  .mobile-nav {
    display: flex;
    flex-direction: column;
    max-height: 0;
    overflow: hidden;
    padding: 0 var(--container-padding);
    background-color: var(--color-bg-primary);
    transition: max-height 0.3s ease, padding 0.3s ease;
  }

  .mobile-nav.is-open {
    max-height: 500px;
    padding: var(--space-lg) var(--container-padding) var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-link {
    display: block;
    padding: var(--space-md) 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--color-accent-gold);
  }

  .mobile-cta {
    margin-top: var(--space-lg);
    text-align: center;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }

    .hamburger {
      display: none;
    }

    .mobile-nav {
      max-height: 0 !important;
      padding: 0 !important;
      overflow: hidden;
    }
  }
</style>

<script>
  const hamburger = document.getElementById("hamburger")!;
  const mobileNav = document.getElementById("mobile-nav")!;

  function isMenuOpen() {
    return hamburger.classList.contains("is-open");
  }

  function openMenu() {
    hamburger.classList.add("is-open");
    mobileNav.classList.add("is-open");
    hamburger.setAttribute("aria-expanded", "true");
    hamburger.setAttribute("aria-label", "Close menu");
    const firstLink = mobileNav.querySelector<HTMLElement>(".mobile-link");
    if (firstLink) firstLink.focus();
  }

  function closeMenu() {
    hamburger.classList.remove("is-open");
    mobileNav.classList.remove("is-open");
    hamburger.setAttribute("aria-expanded", "false");
    hamburger.setAttribute("aria-label", "Open menu");
    hamburger.focus();
  }

  // Toggle on hamburger click
  hamburger.addEventListener("click", () => {
    if (isMenuOpen()) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close mobile menu instantly when clicking anchor links
  // (no transition — otherwise the collapsing height shifts the scroll target)
  mobileNav.querySelectorAll("a[href*='#']").forEach((link) => {
    link.addEventListener("click", () => {
      mobileNav.style.transition = "none";
      closeMenu();
      requestAnimationFrame(() => {
        mobileNav.style.transition = "";
      });
    });
  });

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isMenuOpen()) {
      closeMenu();
    }
  });

  // Focus trap — keep Tab/Shift+Tab inside mobile menu when open
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Tab" || !isMenuOpen()) return;

    const focusable = [
      hamburger,
      ...mobileNav.querySelectorAll<HTMLElement>("a.mobile-link, .mobile-cta"),
    ];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
