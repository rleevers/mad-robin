---
/* ============================================
   Header — Sticky nav with mobile hamburger

   To activate hidden pages, add them to the
   NAV_ITEMS array below.
   ============================================ */

import { Image } from "astro:assets";
import robinLogo from "@/assets/images/robin.png";
import Button from "@/components/ui/Button.astro";
import siteSettings from "@/data/settings/site.yml";

const NAV_ITEMS = [
  { label: "Events", href: "/#events" },
  { label: "Gallery", href: "/#gallery" },
  { label: "About", href: "/#about" },
];

const CTA = { label: "Book Us", href: "/book-us/" };
const currentPath = Astro.url.pathname;

// Hand-drawn icons, shown at the sizes they were drawn relative to each other.
const ICON_SIZE: Record<string, { w: number; h: number }> = {
  facebook: { w: 27, h: 28 },
  instagram: { w: 25, h: 25 },
  youtube: { w: 25, h: 18 },
};

const headerLinks = siteSettings.socialLinks;
const SOCIALS = [
  ...(headerLinks.facebook ? [{ label: "Facebook", href: headerLinks.facebook, icon: "facebook" }] : []),
  ...(headerLinks.instagram ? [{ label: "Instagram", href: headerLinks.instagram, icon: "instagram" }] : []),
  ...(headerLinks.youtube ? [{ label: "YouTube", href: headerLinks.youtube, icon: "youtube" }] : []),
];
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <a href="/" class="logo" aria-label="Mad Robin — Home">
      <span class="logo-img-wrap">
        <Image src={robinLogo} alt="Mad Robin" class="logo-img" width={120} height={90} format="webp" quality={80} />
        <span class="easter-egg-tooltip" aria-hidden="true">The actual dance "Mad Robin" (Playford, 1687) is named after a wandering lunatic figure.</span>
      </span>
      <span class="logo-text">Mad Robin</span>
    </a>

    <!-- Social icons -->
    <div class="social-icons">
      {SOCIALS.map((s) => (
        <a href={s.href} class="social-link" aria-label={s.label} target="_blank" rel="noopener noreferrer">
          <img
            src={`/images/social/${s.icon}.png`}
            alt=""
            width={ICON_SIZE[s.icon].w}
            height={ICON_SIZE[s.icon].h}
            class="social-icon"
          />
        </a>
      ))}
    </div>

    <nav class="desktop-nav" aria-label="Main navigation">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            {...(item.href.startsWith("/#") && currentPath === "/" ? { "aria-current": "page" } : {})}
          >
            {item.label}
          </a>
        ))
      }
      <Button
        href={CTA.href}
        size="sm"
        {...(currentPath.startsWith(CTA.href) ? { "aria-current": "page" } : {})}
      >{CTA.label}</Button>
    </nav>

    <button
      class="hamburger"
      id="hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

      <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
        {
          NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class="mobile-link"
              {...(item.href.startsWith("/#") && currentPath === "/" ? { "aria-current": "page" } : {})}
            >
              {item.label}
            </a>
          ))
        }
        <Button
          href={CTA.href}
          class="mobile-cta"
          {...(currentPath.startsWith(CTA.href) ? { "aria-current": "page" } : {})}
        >{CTA.label}</Button>
      </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .site-header {
      background-color: var(--color-bg-primary-95);
      backdrop-filter: blur(8px);
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-accent);
    font-size-adjust: 0.5;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .logo-img-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .logo-img {
    height: 36px;
    width: auto;
    object-fit: contain;
  }

  .easter-egg-tooltip {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 240px;
    padding: 10px 12px;
    background-color: var(--color-bg-footer-bottom);
    color: var(--color-text-on-accent);
    font-family: var(--font-body);
    font-size: 12px;
    font-style: italic;
    line-height: 1.5;
    border-radius: var(--radius-md);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 200;
  }

  .logo-img-wrap:hover .easter-egg-tooltip {
    opacity: 1;
    transition-delay: 3s;
  }

  /* Social icons */
  .social-icons {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-muted);
    border-radius: var(--radius-full);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .social-link:hover {
    color: var(--color-accent-gold);
  }

/* Header Book Us: a little less height than the standard small button. */
  .desktop-nav :global(.btn) {
    padding-block: 0.38rem;
  }

/* Desktop nav */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-link {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent-gold);
  }

  /* Hamburger button */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text-primary);
    transition: transform var(--transition-base), opacity var(--transition-base);
    pointer-events: none;
  }

  .hamburger.is-open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile nav */
  .mobile-nav {
    display: flex;
    flex-direction: column;
    max-height: 0;
    overflow: hidden;
    padding: 0 var(--container-padding);
    background-color: var(--color-bg-primary);
    transition: max-height 0.3s ease, padding 0.3s ease;
  }

  .mobile-nav.is-open {
    max-height: 500px;
    padding: var(--space-lg) var(--container-padding) var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-link {
    display: block;
    padding: var(--space-md) 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--color-accent-gold);
  }

  .mobile-cta {
    margin-top: var(--space-lg);
    text-align: center;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: flex;
    }

    .hamburger {
      display: none;
    }

    .mobile-nav {
      max-height: 0 !important;
      padding: 0 !important;
      overflow: hidden;
    }
  }

  .social-icon {
    display: block;
    transition: transform var(--transition-fast);
  }

  .social-link:hover .social-icon {
    transform: rotate(-6deg) scale(1.1);
  }
</style>

<script>
  const hamburger = document.getElementById("hamburger")!;
  const mobileNav = document.getElementById("mobile-nav")!;

  function isMenuOpen() {
    return hamburger.classList.contains("is-open");
  }

  function openMenu() {
    hamburger.classList.add("is-open");
    mobileNav.classList.add("is-open");
    hamburger.setAttribute("aria-expanded", "true");
    hamburger.setAttribute("aria-label", "Close menu");
    const firstLink = mobileNav.querySelector<HTMLElement>(".mobile-link");
    if (firstLink) firstLink.focus();
  }

  function closeMenu() {
    hamburger.classList.remove("is-open");
    mobileNav.classList.remove("is-open");
    hamburger.setAttribute("aria-expanded", "false");
    hamburger.setAttribute("aria-label", "Open menu");
    hamburger.focus();
  }

  // Toggle on hamburger click
  hamburger.addEventListener("click", () => {
    if (isMenuOpen()) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close mobile menu instantly when clicking anchor links
  // (no transition — otherwise the collapsing height shifts the scroll target)
  mobileNav.querySelectorAll("a[href*='#']").forEach((link) => {
    link.addEventListener("click", () => {
      mobileNav.style.transition = "none";
      closeMenu();
      requestAnimationFrame(() => {
        mobileNav.style.transition = "";
      });
    });
  });

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isMenuOpen()) {
      closeMenu();
    }
  });

  // Focus trap — keep Tab/Shift+Tab inside mobile menu when open
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Tab" || !isMenuOpen()) return;

    const focusable = [
      hamburger,
      ...mobileNav.querySelectorAll<HTMLElement>("a.mobile-link, .mobile-cta"),
    ];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
